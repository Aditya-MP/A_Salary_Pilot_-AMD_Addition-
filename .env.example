# Frontend config. Copy to .env.local (Vite's own convention; gitignored
# same as backend/.env) and fill in. Everything here ships in the built JS
# bundle — nothing secret belongs in this file. See backend/.env.example
# for what actually needs to stay server-side, and why.

# Defaults to http://localhost:8087 if unset — only needed once the API is
# actually deployed somewhere else (e.g. your Render URL).
VITE_API_URL=

# Google's OAuth Web Client ID — not a secret (see GoogleSignInButton.tsx).
# Get one at https://console.cloud.google.com/apis/credentials. Optional:
# leave empty and the Google Sign-In button simply does not render, no
# broken UI, password sign-in is unaffected.
VITE_GOOGLE_CLIENT_ID=
