# Copy to backend/.env and fill in. .env is gitignored.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
JWT_SECRET=generate-a-real-one-at-least-32-bytes-long
ML_SERVICE_URL=http://localhost:8000
APP_ENV=development

# AI Coach. Optional — the app degrades to local-only agents if unset.
# Get a key at https://aistudio.google.com/apikey. Server-side only, never
# put this in a VITE_-prefixed frontend env var (see internal/gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Sign-In. Optional — password auth works with this unset, the
# Google button just does not render (see GoogleSignInButton.tsx). This is
# the SAME Client ID value as the frontend's VITE_GOOGLE_CLIENT_ID, not a
# separate secret — the server needs it to check incoming tokens' `aud`
# claim actually matches this app, not some other app using the same
# Google Sign-In flow. Get one at
# https://console.cloud.google.com/apis/credentials ("OAuth client ID" →
# "Web application"; add your dev and deployed origins under "Authorized
# JavaScript origins").
GOOGLE_CLIENT_ID=

# The deployed frontend's real origin, e.g. https://salarypilot.vercel.app
# — required in production for CORS (see internal/rpc/server.go's
# withCORS). Leave unset locally; any localhost port is allowed automatically
# in development.
FRONTEND_ORIGIN=
